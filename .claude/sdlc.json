{
  "$comment": "SDLC config for this repo. Process, tiers and templates live in the global `sdlc` skill (~/.claude/skills/sdlc/).",
  "tier": "public",
  "artifacts": {
    "intent": "docs/plans/intent/",
    "spec": "docs/plans/design/",
    "plan": "docs/plans/features/"
  },
  "review_policy": "REVIEW.md",
  "gates": {
    "require_plan_before_code": true,
    "require_spec_for_danger_zone_changes": true,
    "flag_risk_areas_in_summary": true,
    "evals_in_ci": false
  },
  "danger_zones": {
    "$comment": "Paths where a mistake is expensive. A PR touching any of these needs human approval before merge and a spec; everything else merges autonomously. Enforced by .github/workflows/danger-zone.yml.",
    "paths": [
      "processing-engine/app/auth/**",
      "backend/JwstDataAnalysis.API/Controllers/AuthController*.cs",
      "backend/JwstDataAnalysis.API/Services/*AuthService.cs",
      "backend/JwstDataAnalysis.API/Models/AuthModels.cs",
      "frontend/jwst-frontend/src/context/AuthContext.tsx",
      "frontend/jwst-frontend/src/context/useAuth.ts",
      "frontend/jwst-frontend/src/services/authService.ts",
      "frontend/jwst-frontend/src/services/apiClient.ts",
      "processing-engine/app/db/**",
      "processing-engine/app/storage/**",
      "backend/JwstDataAnalysis.API/Services/MongoDBService.cs",
      "backend/JwstDataAnalysis.API/appsettings*.json",
      "docker/.env*",
      "docker/docker-compose*.yml",
      ".github/workflows/**",
      ".github/scripts/**",
      ".claude/hooks/**",
      ".claude/sdlc.json",
      "scripts/server-setup-prod.sh",
      "scripts/public-preflight.sh"
    ]
  }
}
