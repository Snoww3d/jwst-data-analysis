.DS_Store
Thumbs.db

# VSCode
.vscode/

# Misc
*.swp

# Data (ignore large downloaded mast files)
data/mast/
data/
data-agent*/

# Claude Code local settings (skills are committed, everything else is local)
.claude/*
!.claude/skills/
# SDLC config is a versioned artifact — see the global `sdlc` skill
!.claude/sdlc.json
CLAUDE.md

# Staging infrastructure config (contains instance IDs, IPs)
scripts/.staging-config

# Sensitive patterns file (contains actual values to block — must not be committed)
scripts/.sensitive-patterns

# Environment files (prevent accidental commit of secrets)
.env
.env.local
.env.*.local
.env.agent*
*.env

# IDE
.idea/
.obsidian/

# Scratch output
output/

# Logs
logs/

# Credentials (safety net - prevent accidental commit)
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
**/secrets/

# Playwright
test-results/
playwright-report/
blob-report/

site/

# Blog cache (generated data from GitHub API)
docs/blog/.cache/
